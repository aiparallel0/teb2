[
  {
    "id": "teb2-deploy",
    "execute-command": "/opt/teb2/ops/portearchive/redeploy.sh",
    "command-working-directory": "/opt/teb2",
    "response-message": "teb2 redeploy accepted",
    "include-command-output-in-response": false,
    "include-command-output-in-response-on-error": true,
    "trigger-rule": {
      "and": [
        {
          "match": {
            "type": "payload-hmac-sha256",
            "secret": "__TEB2_WEBHOOK_SECRET_PLACEHOLDER__",
            "parameter": {
              "source": "header",
              "name": "X-Hub-Signature-256"
            }
          }
        },
        {
          "match": {
            "type": "value",
            "value": "refs/heads/main",
            "parameter": {
              "source": "payload",
              "name": "ref"
            }
          }
        }
      ]
    }
  }
]
