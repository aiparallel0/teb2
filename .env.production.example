# teb2 production configuration
# Copy to .env and fill in values before deploying.

# Database path (inside container: /app/data/teb2.db)
DB_PATH=/app/data/teb2.db

# Auth secret — CHANGE THIS to a random 32+ character string
SECRET=CHANGE_ME_TO_A_RANDOM_SECRET

# Application port (internal, nginx proxies to this)
PORT=8080

# External port nginx listens on (used by docker-compose)
LISTEN_PORT=80
LISTEN_TLS_PORT=443

# SMTP configuration (optional, for email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# LLM configuration (OpenAI-compatible API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Worker pool size (pre-forked processes sharing the listening socket)
WORKERS=4
